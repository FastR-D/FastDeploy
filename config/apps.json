  "fastread": {
    "repository": "FastR-D/FastRead",
    "legacy_app": "read",
    "unit": "fastdeploy-fastread-api.service",
    "command": [
      "/usr/bin/python3",
      "-m",
      "uvicorn",
      "main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8584",
      "--no-proxy-headers"
    ],
    "services": [
      {
        "unit": "fastdeploy-fastread-api.service",
        "command": [
          "/usr/bin/python3",
          "-m",
          "uvicorn",
          "main:app",
          "--host",
          "127.0.0.1",
          "--port",
          "8584",
          "--no-proxy-headers"
        ],
        "cwd": "{release}/backend"
      },
      {
        "unit": "fastdeploy-fastread-worker.service",
        "command": [
          "/usr/bin/python3",
          "-m",
          "app.web.worker",
          "--concurrency",
          "2"
        ],
        "cwd": "{release}/backend"
      }
    ],
    "health_url": "http://127.0.0.1:8584/api/health",
    "artifact_roots": [
      "backend",
      "fastread-frontend",
      "vendor"
    ],
    "required_files": [
      "backend/main.py",
      "fastread-frontend/dist/index.html",
      "fastread-frontend/dist/vendor/pdfjs/pdf.worker.js",
      "vendor/uvicorn/__init__.py"
    ],
    "required_env": [
      "FASTREAD_WEB_ROOT",
      "FASTREAD_DATA_ROOT"
    ],
    "fixed_env": {
      "FASTREAD_WEB_ROOT": "/home/dev/fastread-web-shared/data",
      "FASTREAD_DATA_ROOT": "/home/dev/fastread-web-shared/compatibility"
    },
    "shared_paths": [
      "/home/dev/fastread-web-shared/data",
      "/home/dev/fastread-web-shared/compatibility"
    ],
    "runtime_check": [
      "/usr/bin/python3",
      "-c",
      "import sys; assert sys.version_info >= (3,12)"
    ],
    "system_legacy": "fastread",
    "release_env": {
      "PYTHONPATH": "{release}/vendor",
      "FASTREAD_WEB_DIST": "{release}/fastread-frontend/dist"
    },
    "public_static": {
      "root": "/var/www/fastread-current",
      "source": "fastread-frontend/dist"
    }
  },
